{
  "name": "@docren/react-native-markdown-bench",
  "private": true,
  "type": "module",
  "description": "Benchmarks and evidence scripts for the v1 rewrite (docs/rewrite: 02-benchmarks, 08-model-and-api, phase-1/decisions P1-1). Private workspace, never published.",
  "scripts": {
    "bench": "node bench.mjs 5",
    "bench:large": "node bench.mjs 60 --no-stream",
    "bench:jitless": "node --jitless bench.mjs 60 --no-stream",
    "model": "node model.mjs 60 time",
    "model:jitless": "node --jitless model.mjs 60 time",
    "model:memory": "for m in mdast tokens tree table; do node --expose-gc model.mjs 60 $m; done",
    "autolink": "node autolink.cjs",
    "autolink:detail": "node autolink.cjs --detail",
    "check:src": "tsx src-check.mjs",
    "convert": "node --import tsx convert.mjs",
    "convert:jitless": "node --jitless --import tsx convert.mjs",
    "stream": "node --import tsx stream.mjs",
    "stream:jitless": "node --jitless --import tsx stream.mjs",
    "scheduler": "node --import tsx scheduler.mjs",
    "scheduler:jitless": "node --jitless --import tsx scheduler.mjs"
  },
  "dependencies": {
    "commonmark": "0.31.2",
    "markdown-it": "15.0.3",
    "marked": "18.1.3",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}
