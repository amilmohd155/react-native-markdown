{
  "name": "@docren/react-native-markdown",
  "version": "0.8.6",
  "description": "Markdown renderer for React Native",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace @docren/react-native-markdown-example",
    "test": "jest --selectProjects unit",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "release": "release-it --only-version",
    "test:spec": "jest --selectProjects spec",
    "check:expo-go": "node scripts/check-no-native.mjs",
    "check:public-types": "node scripts/check-public-types.mjs",
    "test:web": "jest --selectProjects web",
    "build:web-example": "yarn workspace @docren/react-native-markdown-example expo export --platform web --output-dir dist-web",
    "test:e2e:web": "playwright test",
    "perf": "PERF_WARM=1 node node_modules/jest/bin/jest.js --selectProjects perf --runInBand && node --jitless node_modules/jest/bin/jest.js --selectProjects perf --runInBand",
    "perf:update": "PERF_UPDATE=1 yarn perf"
  },
  "keywords": [
    "react-native",
    "md",
    "markdown",
    "renderer",
    "react-native-markdown",
    "commonmark"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amilmohd155/react-native-markdown.git"
  },
  "author": "Amil Muhammed Hamza <amilmohd155@gmail.com> (https://github.com/amilmohd155)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/amilmohd155/react-native-markdown/issues"
  },
  "homepage": "https://github.com/amilmohd155/react-native-markdown#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/compat": "^1.2.7",
    "@evilmartians/lefthook": "^1.5.0",
    "@playwright/test": "^1.49",
    "@react-native/babel-preset": "0.78.2",
    "@react-native/eslint-config": "0.88.1",
    "@release-it/conventional-changelog": "^9.0.2",
    "@testing-library/dom": "^10",
    "@testing-library/react": "^16",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.0.12",
    "commitlint": "^19.6.1",
    "del-cli": "^5.1.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.0.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.4",
    "react-native-builder-bob": "^0.40.12",
    "react-native-web": "^0.21.4",
    "release-it": "19.2.2",
    "test-renderer": "1.0.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.76.0"
  },
  "workspaces": [
    "example",
    "bench"
  ],
  "packageManager": "yarn@3.6.1",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "conventionalcommits"
        }
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "create-react-native-library": {
    "languages": "js",
    "type": "library",
    "version": "0.51.0"
  },
  "dependencies": {
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0"
  }
}
